  background:var(--ember);color:#fff;
  box-shadow:0 8px 20px rgba(219,89,75,.35);
}
.evreach__ico svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.evreach__k{
  font-family:var(--cond);font-weight:700;font-size:13px;
  letter-spacing:.16em;text-transform:uppercase;color:var(--gold);
  display:block;margin-bottom:2px;
}
.evreach__v{
  font-weight:800;font-size:clamp(12.5px,3.8vw,16px);line-height:1.25;
  white-space:nowrap;letter-spacing:-.01em;
}
@media (min-width:640px){
  .evreach{padding:48px 40px 40px}
  .evreach__opt{padding:16px 18px;gap:16px}
  .evreach__ico{width:52px;height:52px}
  .evreach__ico svg{width:24px;height:24px}
  .evreach__v{font-size:16px;letter-spacing:0}
}
@media (min-width:900px){
  .evreach__opts{grid-template-columns:1fr 1fr}
}

/* footer */
.foot{
  background:var(--char);color:var(--cream);text-align:center;
  padding:44px 20px calc(120px + env(safe-area-inset-bottom));font-size:13.5px;
