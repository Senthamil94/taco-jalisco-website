  pointer-events:none;
}
.ehero>*{position:relative;z-index:1}
.ehero .eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--cond);font-weight:700;text-transform:uppercase;
  letter-spacing:.24em;font-size:13px;color:var(--gold);
}
.ehero .eyebrow i{width:26px;height:3px;background:var(--gold);border-radius:2px}
.ehero h1{
