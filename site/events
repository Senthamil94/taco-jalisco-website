.orderbar .btn--ghost{color:var(--cream)}
@media (min-width:900px){
  .orderbar{left:auto;right:32px;bottom:24px;border:0;background:none;backdrop-filter:none;padding:0;grid-template-columns:auto}
  .orderbar .btn--ghost{display:none}
}

</style>
