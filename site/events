    if(d.length<4)return '('+d;
    if(d.length<7)return '('+d.slice(0,3)+') '+d.slice(3);
    return '('+d.slice(0,3)+') '+d.slice(3,6)+'-'+d.slice(6);
  }
  function validateName(el){
    var v=el.value.trim();
    if(!v){el.setCustomValidity('');return}
    if(v.length>MAX_NAME)el.setCustomValidity('Full name can be at most 80 characters.');
    else if(!NAME_OK.test(v))el.setCustomValidity('Full name can only contain letters.');
    else el.setCustomValidity('');
  }
  function validateMessage(el){
    if(!el)return;
    if(el.value.length>MAX_MESSAGE)el.setCustomValidity('Message can be at most 2,000 characters.');
    else el.setCustomValidity('');
  }
  function validatePhone(el){
    var d=usDigits(el.value);
    if(!d){el.setCustomValidity('');return}
    if(!US_NANP.test(d))el.setCustomValidity('Enter a valid US phone number, e.g. (707) 647-0554.');
    else el.setCustomValidity('');
  }
  function guestsDigits(value){
    return value.replace(/\D/g,'').slice(0,3);
  }
  function validateGuests(el){
    var d=guestsDigits(el.value);
    if(!d){el.setCustomValidity('');return}
    var n=parseInt(d,10);
    if(!n||n<1||n>999)el.setCustomValidity('Number of guests can be at most 3 digits (1–999).');
    else el.setCustomValidity('');
  }

  if(nameInput){
    nameInput.addEventListener('input',function(){
      var cleaned=lettersOnly(this.value);
      if(this.value!==cleaned)this.value=cleaned;
      validateName(this);
    });
    nameInput.addEventListener('blur',function(){
      this.value=this.value.trim();
      validateName(this);
    });
  }
  if(phoneInput){
    phoneInput.addEventListener('input',function(){
      this.value=formatUSPhone(usDigits(this.value));
      validatePhone(this);
    });
    phoneInput.addEventListener('blur',function(){
      validatePhone(this);
    });
  }
  if(guestsInput){
    guestsInput.addEventListener('input',function(){
      var cleaned=guestsDigits(this.value);
      if(this.value!==cleaned)this.value=cleaned;
      validateGuests(this);
    });
    guestsInput.addEventListener('blur',function(){
      var n=parseInt(guestsDigits(this.value),10);
      if(n)this.value=String(n);
      validateGuests(this);
    });
  }

  if(messageInput){
    messageInput.addEventListener('input',function(){
      if(this.value.length>MAX_MESSAGE)this.value=this.value.slice(0,MAX_MESSAGE);
      validateMessage(this);
    });
  }

  if(dateInput){
    var today=new Date();
    var y=today.getFullYear();
    var m=String(today.getMonth()+1).padStart(2,'0');
    var d=String(today.getDate()).padStart(2,'0');
    dateInput.min=y+'-'+m+'-'+d;
  }
  if(ef)ef.addEventListener('submit',function(e){
    e.preventDefault();
    if(nameInput){nameInput.value=nameInput.value.trim();validateName(nameInput)}
    if(phoneInput)validatePhone(phoneInput);
    if(guestsInput){
      var n=parseInt(guestsDigits(guestsInput.value),10);
      if(n)guestsInput.value=String(n);
      validateGuests(guestsInput);
    }
    if(messageInput)validateMessage(messageInput);
    if(!ef.checkValidity()){ef.reportValidity();return}
    var btn=document.getElementById('efBtn'),ok=document.getElementById('efOk'),err=document.getElementById('efErr');
    ok.style.display='none';err.style.display='none';
    btn.disabled=true;btn.querySelector('span').textContent='Sending…';
    var data=new FormData(ef);
    if(phoneInput)data.set('Phone Number',usDigits(phoneInput.value));
    fetch(EVENTFORM_ENDPOINT,{method:'POST',body:data,headers:{'Accept':'application/json'}})
      .then(function(r){if(!r.ok)throw 0;return r.json()})
      .then(function(){ok.style.display='block';ef.reset()})
      .catch(function(){err.style.display='block'})
      .finally(function(){btn.disabled=false;btn.querySelector('span').textContent='Submit'});
  });
})();
</script>

</body>
</html>
