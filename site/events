}
.ehero h1 em{font-style:normal;color:var(--ember)}
@media (min-width:900px){.ehero{padding-top:calc(var(--nav-h) + 64px);padding-bottom:48px}}

.wrap{max-width:960px;margin:0 auto;padding:40px 20px calc(120px + env(safe-area-inset-bottom))}

/* offering cards */
.offers{display:grid;gap:16px}
.offercard{
  background:#fff;border-radius:22px;overflow:hidden;
  box-shadow:0 6px 26px rgba(29,20,16,.08);
  display:flex;flex-direction:column;
}
.offercard img{width:100%;aspect-ratio:16/9;object-fit:cover}
.offercard__body{padding:24px 22px 26px;display:flex;flex-direction:column;gap:10px;flex:1}
.offercard h2{
