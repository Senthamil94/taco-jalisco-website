<script>
(function(){
  'use strict';

  /* hiring on/off (config.js) */
  var open = !!(window.SITE_CONFIG && window.SITE_CONFIG.hiringOpen);
  document.getElementById('hiringOpenBlock').hidden = !open;
  document.getElementById('hiringClosedBlock').hidden = open;

  /* application form -> AWS Lambda proxy -> boons-notification-api (email + SMS) */
  var JOBFORM_ENDPOINT='https://gt4vckoxtmxabromp4sqv5k5oq0msnit.lambda-url.us-east-2.on.aws/';
  var MAX_RESUME_BYTES=3*1024*1024;
  var MAX_NAME=50;
  var MAX_MESSAGE=2000;
  var FILE_LABEL='Attach your resume (PDF, max 3 MB)';
  var jf=document.getElementById('jobform');
  var jfFile=document.getElementById('jfFile');
  var nameInput=jf&&jf.querySelector('input[name="Name"]');
  var emailInput=jf&&jf.querySelector('input[name="Email"]');
  var phoneInput=jf&&jf.querySelector('input[name="Phone"]');
  var positionSelect=jf&&jf.querySelector('select[name="Position"]');
  var commentInput=document.getElementById('jfComment');
  var jfErr=document.getElementById('jfErr');
  var jfErrDefault=jfErr?jfErr.innerHTML:'';
  var NAME_OK=/^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+(?: [A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+)*$/;
  var EMAIL_OK=/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
  var US_NANP=/^[2-9]\d{2}[2-9]\d{6}$/;

  function showFieldMsg(el,msg){
    if(!el)return;
    el.classList.toggle('is-invalid',!!msg);
    if(msg)el.setAttribute('aria-invalid','true');
    else el.removeAttribute('aria-invalid');
    el.setCustomValidity(msg||'');
    var wrap=el.closest('.jobform__cell, .jobform__field');
    var box=wrap&&wrap.querySelector('.jobform__msg');
    if(box){
      box.textContent=msg||'';
      box.classList.toggle('is-on',!!msg);
    }
  }
  function lettersOnly(value){
    return value.replace(/[^A-Za-zÁÉÍÓÚÜÑáéíóúüñ ]+/g,'').replace(/ {2,}/g,' ').slice(0,MAX_NAME);
  }
  function usDigits(value){
    var d=value.replace(/\D/g,'');
    if(d.length>=11&&d.charAt(0)==='1')d=d.slice(1);
    return d.slice(0,10);
  }
  function formatUSPhone(d){
    if(!d)return '';
    if(d.length<4)return '('+d;
    if(d.length<7)return '('+d.slice(0,3)+') '+d.slice(3);
    return '('+d.slice(0,3)+') '+d.slice(3,6)+'-'+d.slice(6);
  }
  function validateName(el,requireFilled){
    var v=el.value.trim();
    if(!v){
      if(requireFilled){showFieldMsg(el,'Please enter your full name.');return false}
      showFieldMsg(el,'');return true;
    }
    if(v.length>MAX_NAME){showFieldMsg(el,'Full name can be at most 50 characters.');return false}
    if(!NAME_OK.test(v)){showFieldMsg(el,'Full name can only contain letters.');return false}
    showFieldMsg(el,'');return true;
  }
  function validateEmail(el,requireFilled){
    var v=el.value.trim();
    if(!v){
      if(requireFilled){showFieldMsg(el,'Please enter your email.');return false}
      showFieldMsg(el,'');return true;
    }
    if(!EMAIL_OK.test(v)){showFieldMsg(el,'Enter an email like name@example.com');return false}
    showFieldMsg(el,'');return true;
  }
  function validatePhone(el,requireFilled){
    var d=usDigits(el.value);
    if(!d){
      if(requireFilled){showFieldMsg(el,'Please enter your phone number.');return false}
      showFieldMsg(el,'');return true;
    }
    if(!US_NANP.test(d)){showFieldMsg(el,'Enter a US phone number, e.g. (707) 647-0554.');return false}
    showFieldMsg(el,'');return true;
  }
  function validatePosition(el,requireFilled){
    if(!el.value){
      if(requireFilled){showFieldMsg(el,'Please choose a position.');return false}
      showFieldMsg(el,'');return true;
    }
    showFieldMsg(el,'');return true;
  }
  function validateMessage(el){
    if(!el)return true;
    if(el.value.length>MAX_MESSAGE){showFieldMsg(el,'Message can be at most 2,000 characters.');return false}
    showFieldMsg(el,'');return true;
  }
  function isPdf(file){
    var type=(file.type||'').toLowerCase();
    var name=(file.name||'').toLowerCase();
    return type==='application/pdf'||name.slice(-4)==='.pdf';
  }
  function resetFileUi(){
    var l=document.getElementById('jfFileLabel'),w=jfFile&&jfFile.closest('.jobform__file');
    if(l)l.textContent=FILE_LABEL;
    if(w)w.classList.remove('has-file');
  }
  function showFormError(msg){
    if(!jfErr)return;
    jfErr.textContent=msg;
    jfErr.style.display='block';
  }
  function hideFormError(){
    if(!jfErr)return;
    jfErr.innerHTML=jfErrDefault;
    jfErr.style.display='none';
  }
  function validateResume(){
    if(!jfFile||!jfFile.files.length)return true;
    var file=jfFile.files[0];
    if(!isPdf(file)){
      jfFile.value='';
      resetFileUi();
      showFormError('Please attach a PDF file.');
      return false;
    }
    if(file.size>MAX_RESUME_BYTES){
      jfFile.value='';
      resetFileUi();
      showFormError('Resume PDF must be 3 MB or smaller.');
      return false;
    }
    return true;
  }

  if(positionSelect){
    positionSelect.addEventListener('change',function(){validatePosition(this,true)});
  }
  if(nameInput){
    nameInput.addEventListener('input',function(){
      var cleaned=lettersOnly(this.value);
      if(this.value!==cleaned)this.value=cleaned;
      validateName(this,false);
    });
    nameInput.addEventListener('blur',function(){
      this.value=this.value.trim();
      validateName(this,true);
    });
  }
  if(emailInput){
    emailInput.addEventListener('input',function(){
      validateEmail(this,false);
    });
    emailInput.addEventListener('blur',function(){
      this.value=this.value.trim();
      validateEmail(this,true);
    });
  }
  if(phoneInput){
    phoneInput.addEventListener('input',function(){
      this.value=formatUSPhone(usDigits(this.value));
      validatePhone(this,false);
    });
    phoneInput.addEventListener('blur',function(){
      validatePhone(this,true);
    });
  }
  if(commentInput){
    commentInput.addEventListener('input',function(){
      if(this.value.length>MAX_MESSAGE)this.value=this.value.slice(0,MAX_MESSAGE);
      validateMessage(this);
    });
  }
  if(jfFile)jfFile.addEventListener('change',function(){
    var l=document.getElementById('jfFileLabel'),w=jfFile.closest('.jobform__file');
    hideFormError();
    if(!jfFile.files.length){resetFileUi();return}
    if(!validateResume())return;
    l.textContent=jfFile.files[0].name;w.classList.add('has-file');
  });
  if(jf)jf.addEventListener('submit',function(e){
    e.preventDefault();
    var okFields=true;
    var firstInvalid=null;
    function check(el,fn){
      if(!el)return;
      if(!fn(el,true)){
        okFields=false;
        if(!firstInvalid)firstInvalid=el;
      }
    }
    if(nameInput)nameInput.value=nameInput.value.trim();
    if(emailInput)emailInput.value=emailInput.value.trim();
    check(positionSelect,validatePosition);
    check(nameInput,validateName);
    check(emailInput,validateEmail);
    check(phoneInput,validatePhone);
    check(commentInput,validateMessage);
    if(!okFields){
      if(firstInvalid){
        firstInvalid.focus();
        firstInvalid.scrollIntoView({block:'center',behavior:'smooth'});
      }
      return;
    }
    if(!validateResume())return;
    var hasComment=document.getElementById('jfComment').value.trim().length>0;
    var hasFile=jfFile&&jfFile.files.length>0;
    if(!hasComment&&!hasFile){
      showFormError('Please add a comment or attach a resume — one of the two is required.');
      return;
    }
    var btn=document.getElementById('jfBtn'),ok=document.getElementById('jfOk');
    ok.style.display='none';hideFormError();
    btn.disabled=true;btn.querySelector('span').textContent='Sending…';
    var data=new FormData(jf);
    if(phoneInput)data.set('Phone',usDigits(phoneInput.value));
    fetch(JOBFORM_ENDPOINT,{method:'POST',body:data,headers:{'Accept':'application/json'}})
      .then(function(r){if(!r.ok)throw 0;return r.json()})
      .then(function(){
        ok.style.display='block';
        jf.reset();
        resetFileUi();
        jf.querySelectorAll('.is-invalid').forEach(function(el){el.classList.remove('is-invalid');el.removeAttribute('aria-invalid');el.setCustomValidity('')});
        jf.querySelectorAll('.jobform__msg').forEach(function(el){el.textContent='';el.classList.remove('is-on')});
      })
      .catch(function(){if(jfErr){jfErr.innerHTML=jfErrDefault;jfErr.style.display='block'}})
      .finally(function(){btn.disabled=false;btn.querySelector('span').textContent='Submit application'});
  });
})();
</script>

</body>
</html>
