<style>
:root{
  --ember:#db594b;
  --ember-dk:#c04434;
  --gold:#e9a83a;
  --cream:#f7f0e4;
  --cream-2:#efe3cf;
  --ink:#1d1410;
  --char:#261b14;
  --line:rgba(29,20,16,.14);
  --line-inv:rgba(247,240,228,.16);
  --disp:'Anton',Impact,sans-serif;
  --cond:'Barlow Condensed',Arial Narrow,sans-serif;
  --body:'Manrope',system-ui,sans-serif;
  --nav-h:76px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
}
body{
  font-family:var(--body);font-weight:500;background:var(--cream);color:var(--ink);
  line-height:1.6;font-size:17px;overflow-x:clip;
}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;background:none;border:0;cursor:pointer;color:inherit}
::selection{background:var(--ember);color:var(--cream)}
[hidden]{display:none!important}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  min-height:54px;padding:0 28px;border-radius:999px;
  font-family:var(--cond);font-weight:700;text-transform:uppercase;
  letter-spacing:.14em;font-size:16px;line-height:1;
  transition:transform .18s ease,background .18s ease;
  -webkit-tap-highlight-color:transparent;user-select:none;
}
.btn:active{transform:scale(.97)}
.btn--solid{background:var(--ember);color:#fff;box-shadow:0 8px 24px rgba(219,89,75,.35)}
.btn--solid:hover{background:var(--ember-dk)}
.btn--ghost{border:2px solid currentColor;background:transparent}
.btn--sm{min-height:46px;padding:0 20px;font-size:14px}

/* top bar */
.nav{
  position:fixed;inset:0 0 auto 0;z-index:60;height:var(--nav-h);
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:0 16px;background:#fff;color:var(--ink);
  border-bottom:1px solid var(--line);box-shadow:0 4px 24px rgba(29,20,16,.1);
}
.nav__back{
  display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 6px;
  font-family:var(--cond);font-weight:600;font-size:16px;letter-spacing:.1em;text-transform:uppercase;
}
.nav__back svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.nav__logo img{height:64px;width:auto;object-fit:contain}
@media (min-width:900px){
  :root{--nav-h:88px}
  .nav{padding:0 32px}
  .nav__logo img{height:76px}
}

/* page head */
.hhero{
  background:var(--ink);color:var(--cream);
  padding:calc(var(--nav-h) + 44px) 20px 36px;text-align:center;
  position:relative;overflow:hidden;
}
.hhero::after{
  content:'';position:absolute;inset:0;
  background:radial-gradient(120% 90% at 50% -20%,rgba(219,89,75,.35),transparent 60%);
  pointer-events:none;
}
.hhero>*{position:relative;z-index:1}
.hhero .eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--cond);font-weight:700;text-transform:uppercase;
  letter-spacing:.24em;font-size:13px;color:var(--gold);
}
.hhero .eyebrow i{width:26px;height:3px;background:var(--gold);border-radius:2px}
.hhero h1{
  font-family:var(--disp);font-weight:400;text-transform:uppercase;
  font-size:clamp(34px,8.5vw,64px);line-height:.98;margin:12px 0 0;
}
.hhero h1 em{font-style:normal;color:var(--ember)}
@media (min-width:900px){.hhero{padding-top:calc(var(--nav-h) + 64px);padding-bottom:48px}}

.wrap{max-width:900px;margin:0 auto;padding:40px 20px calc(120px + env(safe-area-inset-bottom))}

/* role cards */
.roles{display:grid;gap:16px}
.role{
  background:#fff;border-radius:18px;padding:24px 22px;
  box-shadow:0 6px 26px rgba(29,20,16,.08);
}
.role__head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:8px}
.role h2{
  font-family:var(--disp);font-weight:400;text-transform:uppercase;
  font-size:clamp(23px,5.5vw,32px);line-height:1;
}
.role__type{
  font-family:var(--cond);font-weight:700;font-size:12.5px;letter-spacing:.16em;text-transform:uppercase;
  background:var(--ink);color:var(--gold);border-radius:999px;padding:5px 12px;white-space:nowrap;
}
.role p{font-size:15.5px;font-weight:500;opacity:.8;line-height:1.65}
@media (min-width:760px){.roles{grid-template-columns:1fr 1fr}}

/* apply band */
.apply{
  background:var(--ink);color:var(--cream);border-radius:22px;
  padding:36px 24px;margin-top:28px;text-align:center;
}
.apply h3{
  font-family:var(--disp);font-weight:400;text-transform:uppercase;
  font-size:clamp(24px,5.8vw,36px);margin-bottom:10px;
}
.apply p{font-weight:600;opacity:.85;max-width:48ch;margin:0 auto 20px}
.apply__btns{display:flex;flex-direction:column;gap:12px;align-items:center}
.apply__btns .btn{width:100%;max-width:380px}
.apply__btns .btn--ghost{color:var(--cream)}
@media (min-width:760px){.apply__btns{flex-direction:row;justify-content:center}.apply__btns .btn{width:auto;min-width:220px}}

/* application form */
.jobform-head{margin-bottom:20px}
.jobform-head h3{
  font-family:var(--disp);font-weight:400;text-transform:uppercase;
  font-size:clamp(25px,6vw,38px);line-height:1.02;margin-bottom:10px;
}
.jobform-head h3 em{font-style:normal;color:var(--ember)}
.jobform-sub{font-weight:600;opacity:.75;font-size:15.5px;margin-bottom:12px}
.jobform-loc{
  display:inline-flex;align-items:center;gap:8px;
  font-family:var(--cond);font-weight:700;font-size:13px;letter-spacing:.16em;text-transform:uppercase;
  background:var(--cream-2);border-radius:999px;padding:7px 14px;
}
.jobform-loc::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--ember)}
.jobform__file{
  display:flex;align-items:center;gap:10px;cursor:pointer;
  padding:14px 16px;border-radius:12px;border:2px dashed var(--line);
  font-weight:700;font-size:15px;color:var(--ink);background:var(--cream);
  transition:border-color .2s;
}
.jobform__file:hover{border-color:var(--ember)}
.jobform__file svg{width:20px;height:20px;stroke:var(--ember);fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}
.jobform__file input{display:none}
.jobform__file.has-file{border-style:solid;border-color:var(--agave)}
.jobform__req{
  font-family:var(--cond);font-weight:600;font-size:13.5px;letter-spacing:.12em;
  text-transform:uppercase;opacity:.6;text-align:center;
}
.jobform-card{
  background:#fff;border-radius:22px;padding:28px 22px;margin-top:28px;
  box-shadow:0 6px 26px rgba(29,20,16,.08);
}
.jobform{display:grid;gap:12px}
.jobform__grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.jobform input,.jobform select,.jobform textarea{
  font:inherit;font-weight:600;font-size:16px;color:var(--ink);
  padding:14px 16px;border-radius:12px;border:2px solid var(--line);
  background:#fff;width:100%;min-height:52px;
}
.jobform textarea{resize:vertical}
.jobform input:focus,.jobform select:focus,.jobform textarea:focus{outline:none;border-color:var(--ember)}
.jobform__cell{display:grid;gap:6px;min-width:0}
.jobform input.is-invalid,.jobform select.is-invalid,.jobform textarea.is-invalid{
  border-color:var(--ember);background:#fdf6f5;
}
.jobform__msg{
  display:none;color:#8c2517;font-size:13.5px;font-weight:700;line-height:1.4;
}
.jobform__msg.is-on{display:block}
.jobform__ok{
  display:none;background:#e6f4e6;border:2px solid #4f7a4a;color:#2c4a28;
  border-radius:12px;padding:16px;font-weight:700;text-align:center;
}
.jobform__err{
  display:none;background:#fdeceb;border:2px solid var(--ember);color:#8c2517;
  border-radius:12px;padding:16px;font-weight:700;text-align:center;
}
@media (max-width:640px){.jobform__grid{grid-template-columns:1fr}}

/* closed notice */
.closed{
  background:#fff;border-radius:22px;padding:56px 24px;text-align:center;
  box-shadow:0 6px 26px rgba(29,20,16,.08);
}
.closed h2{
  font-family:var(--disp);font-weight:400;text-transform:uppercase;
  font-size:clamp(26px,6.5vw,42px);margin-bottom:12px;
}
.closed p{font-weight:600;opacity:.75;max-width:44ch;margin:0 auto 22px}

/* footer */
.foot{
  background:var(--char);color:var(--cream);text-align:center;
  padding:44px 20px calc(120px + env(safe-area-inset-bottom));font-size:13.5px;
}
.foot__logo{height:68px;width:auto;margin:0 auto 14px;object-fit:contain}
.foot p{opacity:.75;font-weight:500;margin-bottom:18px}
.foot__links{display:flex;flex-wrap:wrap;gap:8px 20px;justify-content:center;margin-bottom:22px;font-family:var(--cond);font-weight:600;font-size:15px;letter-spacing:.08em;text-transform:uppercase}
.foot__links a{opacity:.8}
.foot__links a:hover{opacity:1;color:var(--gold)}
.powered-by{display:inline-flex;align-items:center;gap:8px;opacity:.7}

/* sticky order bar */
.orderbar{
  position:fixed;left:0;right:0;bottom:0;z-index:80;
  display:none;grid-template-columns:1fr 1fr;gap:8px;
  padding:12px 12px calc(12px + env(safe-area-inset-bottom));
  background:rgba(29,20,16,.94);backdrop-filter:blur(14px);
  border-top:1px solid var(--line-inv);
}
.orderbar .btn{
  padding:0 10px;font-size:14px;letter-spacing:.06em;white-space:nowrap;
}
.orderbar .btn--ghost{color:var(--cream)}
@media (min-width:900px){.foot{padding-bottom:calc(120px + env(safe-area-inset-bottom))}}
@media (max-width:1024px){
  .orderbar{display:grid !important}
}
@media (min-width:1025px){
  .orderbar{display:none !important}
  .foot{padding-bottom:56px}
}

</style>
</head>
