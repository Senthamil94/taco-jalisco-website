<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Careers — Tacos Jalisco, Vallejo CA</title>
<meta name="description" content="Join the Tacos Jalisco family. We're hiring cooks, cashiers and servers at our restaurant on Sonoma Blvd in Vallejo, CA. Apply in person, by phone or by email.">
<meta name="theme-color" content="#ffffff">
<link rel="canonical" href="https://tacosjaliscovallejo.com/hiring.html">
<link rel="icon" type="image/png" sizes="64x64" href="assets/favicon.png?v=4">
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png?v=4">
<meta name="robots" content="index,follow">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
